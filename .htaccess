AddType font/woff2 .woff2
# invoice-gen.net — Apache settings for Hostinger
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www -> bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]
  # old URLs from earlier versions of the site -> the matching page today (301 keeps rankings)
  RewriteRule ^(free-invoice-generator|invoice-generator|invoice-maker|online-invoice-generator|create-invoice)(/.*)?$ / [L,R=301,NC]
  RewriteRule ^(invoices|customers|products|settings)(/.*)?$ /dashboard/ [L,R=301,NC]
  RewriteCond %{THE_REQUEST} \s/+app/[^\s?]+ [NC]
  RewriteRule ^app/.+$ /dashboard/ [L,R=301,NC]
  RewriteRule ^blog/?$ /guides/ [L,R=301,NC]
  RewriteRule ^blog/professional-invoice-guide-small-business/?$ /how-to-make-an-invoice/ [L,R=301,NC]
  RewriteRule ^blog/multi-currency-invoice-best-practices/?$ /freelance-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(payment-term|net-30|cash-flow)[^/]*/?$ /payment-terms/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(reminder|late-payment|overdue|unpaid|chase)[^/]*/?$ /payment-reminder/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*receipt[^/]*/?$ /invoice-vs-receipt/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(timesheet|hourly|hours|shift)[^/]*/?$ /timesheet-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(quote|quotation)[^/]*/?$ /quote-generator/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*estimate[^/]*/?$ /estimate-maker/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*proforma[^/]*/?$ /proforma-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*contractor[^/]*/?$ /contractor-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*clean[^/]*/?$ /cleaning-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*consult[^/]*/?$ /consulting-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*photo[^/]*/?$ /photography-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(self-employed|sole-trader)[^/]*/?$ /self-employed-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(freelanc|currenc|international)[^/]*/?$ /freelance-invoice/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*template[^/]*/?$ /invoice-template/ [L,R=301,NC]
  RewriteRule ^blog/[^/]*(how-to|guide|what-is|invoice)[^/]*/?$ /how-to-make-an-invoice/ [L,R=301,NC]
  RewriteRule ^blog/.+$ /guides/ [L,R=301,NC]
  # short and guessed addresses -> the real page
  RewriteRule ^(templates?|invoice-templates|invoice-templates?/.*)/?$ /invoice-template/ [L,R=301,NC]
  RewriteRule ^tools/?$ /invoice-tools/ [L,R=301,NC]
  RewriteRule ^(signup|sign-up|register|create-account)/?$ /login/?signup=1 [L,R=301,NC]
  RewriteRule ^(signin|sign-in|log-in|account)/?$ /login/ [L,R=301,NC]
  RewriteRule ^(pricing|price|features|about-us)/?$ /about/ [L,R=301,NC]
  RewriteRule ^(contact-us|support|help)/?$ /contact/ [L,R=301,NC]
  RewriteRule ^(privacy-policy)/?$ /privacy/ [L,R=301,NC]
  RewriteRule ^(terms-of-service|terms-and-conditions|tos)/?$ /terms/ [L,R=301,NC]
  RewriteRule ^(guide|faq|resources|articles)/?$ /guides/ [L,R=301,NC]
  RewriteRule ^(quote|quotes|quotation|quotation-generator|quote-maker)/?$ /quote-generator/ [L,R=301,NC]
  RewriteRule ^(receipt|receipts|receipt-maker)/?$ /receipt-generator/ [L,R=301,NC]
  RewriteRule ^(estimate|estimates|estimate-generator)/?$ /estimate-maker/ [L,R=301,NC]
  RewriteRule ^(proforma|proforma-invoice-generator|pro-forma-invoice)/?$ /proforma-invoice/ [L,R=301,NC]
  RewriteRule ^(timesheet|timesheet-invoice-generator)/?$ /timesheet-invoice/ [L,R=301,NC]
  RewriteRule ^(uk-invoice|vat-invoice|vat-invoice-template)/?$ /uk-invoice-template/ [L,R=301,NC]
  RewriteRule ^(currency|currencies|converter|exchange-rate|exchange-rates|currency-exchange)/?$ /currency-converter/ [L,R=301,NC]
  RewriteRule ^(gst-invoice-australia|tax-invoice)/?$ /gst-invoice/ [L,R=301,NC]
  RewriteRule ^(gst-bill|gst-invoice-format)/?$ /gst-invoice-india/ [L,R=301,NC]
  # never serve repo/setup files
  RewriteRule ^(\.git|\.github|supabase|tools|README\.md) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/manifest+json text/xml application/xml
</IfModule>
